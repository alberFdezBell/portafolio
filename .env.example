# ========================================================
# PORTAFOLIO - VARIABLES DE ENTORNO (PORTAINER)
# ========================================================

# Puerto interno y de escucha del contenedor
PORT=1886

# Entorno de ejecución
NODE_ENV=production

# URL canónica pública para SEO y generación de sitemap (ej: https://tu-dominio.com o http://tu-ip:1886)
NEXT_PUBLIC_SITE_URL=http://localhost:1886

# --------------------------------------------------------
# SEGURIDAD Y ACCESO DE ADMINISTRACIÓN (/admin)
# --------------------------------------------------------

# Nombre de usuario del administrador
ADMIN_USER=admin

# Contraseña maestra de administración (Cámbiala en producción)
ADMIN_PASSWORD=admin1234

# Clave secreta para firmar sesiones HMAC-SHA256 (32+ caracteres recomendados)
AUTH_SECRET=cambia-esta-clave-secreta-por-una-cadena-aleatoria-larga-1886

# Clave secreta Base32 para el 2FA con Authenticator (Opcional)
# Si la dejas vacía, la aplicación generará una en el primer arranque y podrás
# escanear el código QR directamente desde la pestaña "Seguridad & 2FA" del panel.
TOTP_SECRET=
